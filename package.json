    "test:zalo-official:sql": "tsx tools/zalo-reader/parsers/official-sql.test.ts",
    "test:zalo-official:ui": "tsx tools/zalo-reader/parsers/official-admin-ui.test.ts",
    "test:zalo-pending-modal": "tsx tools/zalo-reader/parsers/pending-modal-approve-ui.test.ts",
    "test:room-features": "tsx tools/rooms/amenities-search.test.ts && node --no-wasm-tier-up --import tsx tools/rooms/amenities-search-sql.test.ts && tsx tools/rooms/amenities-ui.test.ts",
    "test:zalo-production-media": "tsx tools/zalo-reader/parsers/production-media-regression.test.ts && tsx tools/zalo-reader/parsers/test-pending-api.test.ts",
    "test:zalo-production": "tsx tools/zalo-reader/parsers/production-mode.test.ts && tsx tools/zalo-reader/parsers/import-property-publish.test.ts && npm run test:zalo-production-media",
