    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.43.0",
    "archiver": "^7.0.1",
    "heic2any": "0.0.4",
    "lucide-react": "^0.474.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-easy-crop": "^6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^7.0.0",
