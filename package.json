    "test:zalo-preview": "tsx tools/zalo-reader/parsers/phase5-preview-smoke-test.ts",
    "test:zalo-staging": "tsx tools/zalo-reader/parsers/controlled-staging.test.ts",
    "patch:zalo-parser-phase1": "node tools/zalo-reader/apply-phase1-parser-wiring.mjs",
    "build:webpack": "next build --webpack",
    "patch:zalo-parser-phase2-final": "node tools/zalo-reader/apply-phase2-final-marker-album.mjs",
    "patch:zalo-reader-phase3": "node tools/zalo-reader/apply-phase3-24h-import-limit.mjs",
    "test:zalo-lookback": "tsx tools/zalo-reader/parsers/phase3-message-lookback-smoke-test.ts",
    "patch:zalo-reader-final": "node tools/zalo-reader/apply-final-building-room-architecture.mjs",
    "map:geocode": "tsx tools/map/geocode-properties.ts",
    "test:performance": "node --test tools/performance/performance-regression-smoke-test.mjs"
